@model IEnumerable<CookHouse.Models.ProductCategory>
<div class="category">
    <div class="category-title">
        danh mục sản phẩm
    </div>
    <div class="accordion">
        @foreach (var item in Model.Where(a => a.ParentId == null))
        {
            <div class="card">
                <div class="card-header" id="heading-@item.Id">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="mb-0">
                            <a href="@Url.Action("ProductCategory", "Home", new {url = item.Url})">@item.CategoryName (@item.Products.Count())</a>
                        </h2>
                        @if (Model.Any(a => a.ParentId == item.Id))
                        {
                            <button class="btn-card" type="button" data-toggle="collapse" data-target="#collapse-@item.Id" aria-expanded="false" aria-controls="collapse-@item.Id">
                                <i class="far fa-chevron-down"></i>
                            </button>
                        }
                    </div>
                </div>
                @if (Model.Any(a => a.ParentId == item.Id))
                {
                    <div id="collapse-@item.Id" class="collapse">
                        <div class="card-body">
                            <ul class="pl-0 mb-0">
                                @foreach (var child in Model.Where(p => p.ParentId == item.Id))
                                {
                                    <li>
                                        <a href="@Url.Action("ProductCategory", "Home", new {url = child.Url})">
                                            @child.CategoryName (@child.Products.Count())
                                        </a>
                                        @if (Model.Any(a => a.ParentId == child.Id))
                                        {
                                            <i class="fas fa-caret-down icon-dropdown-cat" data-toggle="collapse" data-target="#cat3-@child.Id" aria-controls="#cat3-@item.Id"></i>
                                            <ul class="ul-reset menu-child__lv2 collapse" id="cat3-@child.Id">
                                                @foreach (var third in Model.Where(a => a.ParentId == child.Id))
                                                {
                                                    <li>
                                                        <a href="@Url.Action("ProductCategory", "Home", new { url = third.Url })">
                                                            @third.CategoryName (@third.Products.Count())
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>