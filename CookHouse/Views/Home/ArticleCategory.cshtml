@model CookHouse.ViewModel.ArticleViewModel
@using PagedList.Mvc
@{
    ViewBag.Title = Model.ArticleCategory.TitleMeta ?? Model.ArticleCategory.CategoryName;
    ViewBag.Description = Model.ArticleCategory.DescriptionMeta ?? Model.ArticleCategory.Description;
    ViewBag.Canonical = Request.Url?.GetLeftPart(UriPartial.Authority) + Url.Action("ArticleCategory", "Home", new { url = Model.ArticleCategory.Url });

    var fa = Model.Articles.FirstOrDefault();
    if (fa?.Image != null)
    {
        ViewBag.ImageShare = Request.Url?.GetLeftPart(UriPartial.Authority) + Path.Combine("/images/articles/", fa.Image);
    }
}
<div class="container">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/">
                <i class="fas fa-home"></i>
                Trang chủ
            </a>
            <i class="far fa-angle-right ml-1"></i>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            @Model.ArticleCategory.CategoryName
        </li>
    </ol>
    <div class="row mb-4">
        <div class="col-lg-3 order-lg-0 order-1">
            @Html.Action("MenuLeftArticle")
        </div>
        <div class="col-lg-9 order-lg-1 order-0">
            <div class="row box-article">
                @if (Model.Articles.Any())
                {
                    foreach (var item in Model.Articles)
                    {
                        <div class="col-lg-4 col-md-4 col-6">
                            @Html.Partial("_ItemArticle", item)
                        </div>
                    }
                    if (Model.Articles.PageCount > 1)
                    {
                        <div class="col-12 text-center">
                            @Html.PagedListPager(Model.Articles, page => Url.Action("ArticleCategory", new { page }))
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <p class="alert alert-success small">Nội dung hiện chưa được cập nhật. Vui lòng quay lại sau !!!!</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
