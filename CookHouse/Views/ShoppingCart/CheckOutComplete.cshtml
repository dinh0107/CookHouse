@model CookHouse.Models.Order
@using CookHouse.Models
@{
    ViewBag.Title = "Đặt hàng thành công";
    var configsite = (ConfigSite)HttpContext.Current.Application["ConfigSite"];
    var typepay = "Hình thức thanh toán";
    var transport = "Hình thức vận chuyển";
    switch (Model.TypePay)
    {
        case 1:
            typepay = "Chuyển khoản";
            break;
        case 2:
            typepay = "Chuyển khoản VNPAY";
            break;
        case 3:
            typepay = "Thanh toán khi giao hàng (COD)";
            break;
    }
    switch (Model.Transport)
    {
        case 1:
            transport = "Thường";
            break;
        case 2:
            transport = "Nhanh";
            break;
        case 3:
            transport = "Hỏa tốc";
            break;
    }
}

<div class="d-flex align-items-center justify-content-center">
    <div class="receipt-main">
        <div class="receipt-header receipt-header-mid row">
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <div class="receipt-right">
                    <h5>Thông tin </h5>
                    <p><b>Họ và tên :</b> @Model.CustomerInfo.Fullname</p>
                    <p><b>Mobile :</b> @Model.CustomerInfo.Mobile</p>
                    <p><b>Email :</b> @Model.CustomerInfo.Email</p>
                    <p><b>Địa chỉ :</b> @Model.CustomerInfo.Address</p>
                    <p><b>Hình thức vận chuyển :</b> @transport</p>
                    <p><b>Hình thức thanh toán :</b> @typepay</p>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4 mt-lg-0 mt-3">
                <div class="receipt-left">
                    Mã hóa đơn: <br />
                    <span> @Model.MaDonHang</span>
                </div>
            </div>
        </div>
        <div class="scroll-hidden shadow-none rounded-0">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-center">Giá</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        var price = item.Quantity * item.Price;
                        <tr>
                            <td>@item.Product.Name</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-center">
                                @if (price == 0)
                                {
                                    @: Liên hệ
                                }
                                else
                                {
                                    @Convert.ToDecimal(price).ToString("N0") @:đ
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="total-bill text-right mb-2">
            Phí vận chuyển: <strong>@Html.DisplayFor(a => a.ShipFee) đ</strong>
        </div>
        <div class="total-bill text-right">
            Tổng tiền: <strong>@Model.TotalFee().ToString("N0")đ</strong>
        </div>
        @if (Model.TypePay == 1)
        {
            <div class="title-check">
                Thông tin chuyển khoản
            </div>
            <div class="content-detail mt-3">
                @Html.Raw(configsite.BankInfo)
            </div>
        }
        @if (Model.TypePay == 2)
        {
            <div class="title-check">
                VN PAY QR
            </div>
            if (configsite.QRImage != null)
            {
                <div class="qr-code mb-1 text-center d-block">
                    <img src="~/Content/images/base64.gif" data-src="@Path.Combine("/images/configs/", configsite.QRImage)" alt="QR CODE" class="lazyload" />
                </div>
            }
        }
        <div class="row receipt-header receipt-header-mid receipt-footer">
            <div class="col-xs-8 col-sm-8 col-md-8 text-left">
                <div class="receipt-right">
                    <p><b>Ngày :</b>@Model.CreateDate.ToString("dd/MM/yyyy")</p>
                    <div style="color: rgb(140, 140, 140);">Cảm ơn bạn đã mua sắm.!</div>
                </div>
            </div>
        </div>
    </div>
</div>